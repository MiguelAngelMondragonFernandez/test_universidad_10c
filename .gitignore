# Este archivo .gitignore debe colocarse en el directorio raíz de tu proyecto de Unity.

/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Mm]emoryCaptures/

# Autogenerated project files
/Assets/AssetStoreTools*
/Assets/AddressableAssetsData/*/*.bin*
/Assets/StreamingAssets/aa.meta
/Assets/StreamingAssets/aa/*

# Builds
*.apk
*.aab
*.app
*.exe
*.ipa
*.unitypackage

# Crashlytics generated file
crashlytics-build.properties

# Visual Studio / MonoDevelop / Rider
.vs/
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta.meta

# Unity3D Generated File On Crash Reports
sysinfo.txt

# Mac
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Icon?
ehthumbs.db
Thumbs.db
